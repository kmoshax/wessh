#!/bin/sh
set -eu
app_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$app_dir/usr/bin:$PATH"
export CURL_CA_BUNDLE="${CURL_CA_BUNDLE:-$app_dir/usr/share/wessh/ca-certificates.crt}"
exec "$app_dir/usr/bin/wessh" "$@"
